<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Diddipoeler\Component\SportsManagement\Administrator\Field">
    <fieldset name="details" label="COM_SPORTSMANAGEMENT_TABS_DETAILS" description="COM_SPORTSMANAGEMENT_TABS_DETAILS_DESC">
        <field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" description="JGLOBAL_FIELD_ID_DESC" class="readonly" default="0" readonly="true" />
        <field name="checked_out" type="hidden" filter="unset" />
        <field name="checked_out_time" type="hidden" filter="unset" />
        <field name="new_club_id" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_NEW_CLIB_ID" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_NEW_CLIB_ID_DESC" />
        <field name="name" type="text" maxlength="200" label="COM_SPORTSMANAGEMENT_GLOBAL_NAME" description="COM_SPORTSMANAGEMENT_GLOBAL_NAME_DESC" required="true" />
        <field name="alias" type="text" maxlength="200" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" readonly="true" />
        <field name="admin" type="user" default="0" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_ADMIN" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_ADMIN_DESC" />
        <field name="geocomplete" type="geocomplete" readonly="true" label="COM_SPORTSMANAGEMENT_LOCATION_FIELD_GEOCOMPLETE_LABEL" description="COM_SPORTSMANAGEMENT_LOCATION_FIELD_GEOCOMPLETE_DESC" />
        <field name="country" type="country" onchange="getlatlonopenstreet(1);" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_COUNTRY" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_COUNTRY_DESC" required="true">
            <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_COUNTRY</option>
        </field>
        <field name="state" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_STATE" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_STATE_DESC" />
        <field name="location" type="text" onchange="getlatlonopenstreet(1);" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_CITY" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_CITY_DESC" />
        <field name="zipcode" type="text" onchange="getlatlonopenstreet(1);" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_POSTAL_CODE" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_POSTAL_CODE_DESC" />
        <field name="address" type="text" onchange="getlatlonopenstreet(1);" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_ADDRESS" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_ADDRESS_DESC" />
        <field name="latitude" type="text" default="0.00000000" readonly="true" label="COM_SPORTSMANAGEMENT_GLOBAL_LATITUDE" description="COM_SPORTSMANAGEMENT_GLOBAL_LATITUDE_DESC" />
        <field name="longitude" type="text" default="0.00000000" readonly="true" label="COM_SPORTSMANAGEMENT_GLOBAL_LONGITUDE" description="COM_SPORTSMANAGEMENT_GLOBAL_LONGITUDE_DESC" />
        <field name="associations" type="dependsql" size="10" depends="country" task="associationsoptions" value_field="country" key_field="country" default="0" norequest="1" label="COM_SPORTSMANAGEMENT_ADMIN_PERSON_ASSOCIATION" description="COM_SPORTSMANAGEMENT_ADMIN_PERSON_ASSOCIATION_DESC">
            <option value="0">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_DO_NOT_USE</option>
        </field>
        <field name="phone" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_PHONE" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_PHONE_DESC" />
        <field name="fax" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_FAX" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_FAX_DESC" />
        <field name="email" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_EMAIL" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_EMAIL_DESC" />
        <field name="website" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_WEBSITE" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_WEBSITE_DESC" />
        <field name="twitter" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_TWITTER" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_TWITTER_DESC" />
        <field name="facebook" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_FACEBOOK" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_FACEBOOK_DESC" />
        <field name="instagram" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_INSTAGRAM" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_INSTAGRAM_DESC" />
        <field name="linkedin" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_LINKEDIN" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_LINKEDIN_DESC" />
        <field name="manager" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_GENERAL_MANAGER" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_GENERAL_MANAGER_DESC" />
        <field name="president" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_PRESIDENT" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_PRESIDENT_DESC" />
        <field name="founded" type="calendar" format="%d-%m-%Y" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_FOUNDED" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_FOUNDED_DESC" />
        <field name="dissolved" type="calendar" format="%d-%m-%Y" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_DISSOLVED" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_DISSOLVED_DESC" />
        <field name="standard_playground" type="playgroundlist2" default="0" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_VENUE" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_VENUE_DESC">
            <option value="0">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_PLAYGROUND</option>
        </field>
        <field name="merge_teams" type="teamlist" multiple="true" size="15" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_TEAM_MERGE" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_TEAM_MERGE_DESC">
            <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_DO_NOT_USE</option>
        </field>
        <field name="enable_sb" type="extensionradiobutton" default="0" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_KUNENA" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_KUNENA_DESC">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="sb_catid" type="KunenaCategoryList" size="5" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_KUNENA_FORUM_ID" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_KUNENA_FORUM_ID_DESC" />
        <field name="founded_year" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_FOUNDED_YEAR" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_FOUNDED_YEAR_DESC" />
        <field name="dissolved_year" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_DISSOLVED_YEAR" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_DISSOLVED_YEAR_DESC" />
        <field name="unique_id" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_UNIQUE_ID" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_UNIQUE_ID_DESC" />
    </fieldset>

    <fieldset name="teamsofclub" label="COM_SPORTSMANAGEMENT_TABS_TEAMS_OF_CLUB" description="COM_SPORTSMANAGEMENT_TABS_TEAMS_OF_CLUB_DESC" />

    <fieldset name="picture" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_LOGO" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_LOGO_DESC">
        <field name="link_logo_big" type="text" label="Bildlink zum kopieren" description="Bildlink zum kopieren" />
        <field name="logo_big" type="media" default="images/com_sportsmanagement/database/clubs/large/placeholder_wappen_150.png" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_LOGO_LARGE" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_LOGO_LARGE_DESC" preview="show" directory="images/com_sportsmanagement/database/clubs/large" />
        <field name="logo_middle" type="hidden" />
        <field name="logo_small" type="hidden" />
        <field name="cr_logo_big" type="text" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_LOGO_BIG_CR" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_LOGO_BIG_CR_DESC" />
        <field name="trikot_home" type="media" default="images/com_sportsmanagement/database/clubs/trikot_home/placeholder_small.gif" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_TRIKOT_HOME" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_TRIKOT_HOME_DESC" preview="show" directory="images/com_sportsmanagement/database/clubs/trikot_home" />
        <field name="trikot_away" type="media" default="images/com_sportsmanagement/database/clubs/trikot_away/placeholder_small.gif" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_TRIKOT_AWAY" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_TRIKOT_AWAY_DESC" preview="show" directory="images/com_sportsmanagement/database/clubs/trikot_away" />
    </fieldset>

    <fieldset name="clublogohistory" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_LOGO_HISTORY" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_LOGO_HISTORY_DESC" />
    <fieldset name="extended" label="COM_SPORTSMANAGEMENT_TABS_EXTENDED" description="COM_SPORTSMANAGEMENT_TABS_EXTENDED_DESC" />
    <fieldset name="extra_fields" label="COM_SPORTSMANAGEMENT_TABS_EXTRA_FIELDS" description="COM_SPORTSMANAGEMENT_TABS_EXTRA_FIELDS_DESC" />

    <fieldset name="special_fields" label="COM_SPORTSMANAGEMENT_TABS_SPECIAL_FIELDS" description="COM_SPORTSMANAGEMENT_TABS_SPECIAL_FIELDS_DESC">
        <field name="use_jl" type="extensionradiobutton" default="0" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_JL" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_JL_DESC">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="use_jsm" type="extensionradiobutton" default="0" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_JSM" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_JSM_DESC">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>

    <fieldset name="description" label="COM_SPORTSMANAGEMENT_TABS_DESCRIPTION" description="COM_SPORTSMANAGEMENT_TABS_DESCRIPTION_DESC">
        <field name="notes" type="editor" label="COM_SPORTSMANAGEMENT_ADMIN_PERSON_DESCRIPTION" description="COM_SPORTSMANAGEMENT_ADMIN_PERSON_DESCRIPTION_DESC" filter="safehtml" />
    </fieldset>
</form>
