<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter" addfieldprefix="Diddipoeler\Component\SportsManagement\Administrator\Field">
        <field name="search" type="text" inputmode="search" label="JGLOBAL_LOOKING_FOR" description="JGLOBAL_LOOKING_FOR" hint="JSEARCH_FILTER" />
        <field name="state" type="status" class="state" label="JOPTION_SELECT_PUBLISHED" description="JOPTION_SELECT_PUBLISHED_DESC" onchange="this.form.submit();">
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>
        <field name="search_nation" type="Country" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_COUNTRY" description="COM_SPORTSMANAGEMENT_ADMIN_CLUB_COUNTRY_DESC" required="false" onchange="this.form.submit();">
            <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_COUNTRY</option>
        </field>
        <field name="search_countrymap" type="list" default="" onchange="this.form.submit();" label="COM_SPORTSMANAGEMENT_GLOBAL_SELECT_COUNTRYMAP" description="COM_SPORTSMANAGEMENT_GLOBAL_SELECT_COUNTRYMAP">
            <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_COUNTRYMAP</option>
            <option value="IS NULL">JNO</option>
            <option value="IS NOT NULL">JYES</option>
        </field>
    </fields>
    <fields name="list">
        <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();" />
    </fields>
</form>
