<?xml version="1.0" encoding="utf-8"?>
<form>
  <fields name="filter" addfieldprefix="Diddipoeler\Component\SportsManagement\Administrator\Field">
    <field name="search" type="text" inputmode="search" label="JSEARCH_FILTER" hint="JSEARCH_FILTER" />
    <field name="state" type="status" label="JOPTION_SELECT_PUBLISHED">
      <option value="">JOPTION_SELECT_PUBLISHED</option>
    </field>
    <field name="search_nation" type="Country" label="COM_SPORTSMANAGEMENT_ADMIN_LEAGUE_COUNTRY">
      <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_COUNTRY</option>
    </field>
    <field name="search_agegroup" type="Agegroup" label="COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_AGEGROUP">
      <option value="">COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_AGEGROUP_FILTER</option>
    </field>
    <field name="search_federation" type="Federation" label="COM_SPORTSMANAGEMENT_GLOBAL_FEDERATION">
      <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_FEDERATION</option>
    </field>
    <field name="search_associations_leagues" type="Association" label="COM_SPORTSMANAGEMENT_ADMIN_LEAGUE_ASSOCIATION">
      <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_ASSOCIATION</option>
    </field>
    <field name="search_league_level" type="Leaguelevel" label="COM_SPORTSMANAGEMENT_ADMIN_LEAGUE_LEVEL">
      <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_LEAGUE_LEVEL</option>
    </field>
    <field name="search_champions_complete" type="list" label="COM_SPORTSMANAGEMENT_ADMIN_LEAGUE_CHAMPIONS_COMPLETE">
      <option value="">JOPTION_SELECT_STATUS</option>
      <option value="0">JNO</option>
      <option value="1">JYES</option>
    </field>
  </fields>
  <fields name="list">
    <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();" />
  </fields>
</form>
