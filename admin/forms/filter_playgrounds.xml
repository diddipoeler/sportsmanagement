<?xml version="1.0" encoding="utf-8"?>
<form>
  <fields name="filter">
    <field name="search" type="text" inputmode="search" label="JGLOBAL_LOOKING_FOR" hint="JSEARCH_FILTER"/>
    <field name="state" type="status" label="JOPTION_SELECT_PUBLISHED" onchange="this.form.submit();"><option value="">JOPTION_SELECT_PUBLISHED</option></field>
    <field name="search_nation" type="Country" label="COM_SPORTSMANAGEMENT_ADMIN_PLAYGROUND_COUNTRY" onchange="this.form.submit();"><option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_COUNTRY</option></field>
  </fields>
  <fields name="list">
    <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="v.name ASC" onchange="this.form.submit();"><option value="">JGLOBAL_SORT_BY</option><option value="v.name ASC">JGLOBAL_TITLE_ASC</option><option value="v.name DESC">JGLOBAL_TITLE_DESC</option><option value="v.country ASC">COM_SPORTSMANAGEMENT_ADMIN_PLAYGROUND_COUNTRY</option><option value="v.id ASC">JGRID_HEADING_ID</option><option value="v.id DESC">JGRID_HEADING_ID</option></field>
    <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();"/>
  </fields>
</form>
