<?xml version="1.0" encoding="utf-8"?>
<form>
  <fields name="filter" addfieldprefix="Diddipoeler\Component\SportsManagement\Administrator\Field">
    <field name="search" type="text" inputmode="search" label="JSEARCH_FILTER" hint="JSEARCH_FILTER" />

    <field name="state" type="status" label="JOPTION_SELECT_PUBLISHED" onchange="this.form.submit();">
      <option value="">JOPTION_SELECT_PUBLISHED</option>
    </field>

    <field name="sports_type" type="Sportstype" label="COM_SPORTSMANAGEMENT_GLOBAL_SPORT_TYPE" onchange="this.form.submit();">
      <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SPORT_TYPE_SELECT</option>
    </field>

    <field name="search_agegroup" type="Agegroup" label="COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_AGEGROUP" onchange="this.form.submit();">
      <option value="">COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_AGEGROUP_FILTER</option>
    </field>

    <field name="search_nation" type="Country" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_COUNTRY" onchange="this.form.submit();">
      <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_COUNTRY</option>
    </field>

    <field name="search_associations_leagues" type="AssociationsList" label="COM_SPORTSMANAGEMENT_ADMIN_LEAGUE_ASSOCIATION" onchange="this.form.submit();">
      <option value="0">COM_SPORTSMANAGEMENT_ADMIN_LEAGUE_ASSOCIATION</option>
    </field>

    <field name="search_league" type="League" label="COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_LEAGUES_FILTER" onchange="this.form.submit();">
      <option value="0">COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_LEAGUES_FILTER</option>
    </field>

    <field name="userfields" type="Userfields" label="COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_USERFIELD_FILTER" onchange="this.form.submit();">
      <option value="">COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_USERFIELD_FILTER</option>
    </field>

    <field name="season" type="Seasonlist" label="COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_SEASON_FILTER" onchange="this.form.submit();">
      <option value="">COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_SEASON_FILTER</option>
    </field>

    <field name="copytoseason" type="Seasonlist" label="COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_COPYTOSEASON_FILTER">
      <option value="">COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_COPYTOSEASON_FILTER</option>
    </field>

    <field name="project_type" type="list" label="COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_PROJECTTYPE_FILTER" onchange="this.form.submit();">
      <option value="">COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_PROJECTTYPE_FILTER</option>
      <option value="SIMPLE_LEAGUE">COM_SPORTSMANAGEMENT_SIMPLE_LEAGUE</option>
      <option value="DIVISIONS_LEAGUE">COM_SPORTSMANAGEMENT_DIVISIONS_LEAGUE</option>
      <option value="TOURNAMENT_MODE">COM_SPORTSMANAGEMENT_TOURNAMENT_MODE</option>
      <option value="FRIENDLY_MATCHES">COM_SPORTSMANAGEMENT_FRIENDLY_MATCHES</option>
    </field>

    <field name="show_notassign" type="list" label="COM_SPORTSMANAGEMENT_GLOBAL_SELECT_NOT_ASSIGN" onchange="this.form.submit();">
      <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_NOT_ASSIGN</option>
      <option value="0">JNO</option>
      <option value="1">JYES</option>
    </field>
  </fields>

  <fields name="list">
    <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();" />
  </fields>
</form>
