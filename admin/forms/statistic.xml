<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Diddipoeler\Component\SportsManagement\Administrator\Field">
    <fieldset
        name="details"
        label="COM_SPORTSMANAGEMENT_TABS_DETAILS"
        description="COM_SPORTSMANAGEMENT_TABS_DETAILS_DESC">
        <field
            name="id"
            type="number"
            label="JGLOBAL_FIELD_ID_LABEL"
            description="JGLOBAL_FIELD_ID_DESC"
            default="0"
            readonly="true"/>
        <field name="checked_out" type="hidden" filter="unset"/>
        <field name="checked_out_time" type="hidden" filter="unset"/>
        <field
            name="name"
            type="text"
            label="COM_SPORTSMANAGEMENT_GLOBAL_NAME"
            description="COM_SPORTSMANAGEMENT_GLOBAL_NAME_DESC"
            required="true"/>
        <field
            name="short"
            type="text"
            size="10"
            maxlength="6"
            label="COM_SPORTSMANAGEMENT_ADMIN_STAT_ABBREV"
            description="COM_SPORTSMANAGEMENT_ADMIN_STAT_ABBREV_DESC"
            required="true"/>
        <field name="calculated" type="hidden" default="0"/>
        <field name="baseparams" type="hidden"/>
        <field
            name="alias"
            type="text"
            label="JFIELD_ALIAS_LABEL"
            description="JFIELD_ALIAS_DESC"/>
        <field
            name="sports_type_id"
            type="sportstypelist"
            default="0"
            label="COM_SPORTSMANAGEMENT_GLOBAL_SPORT_TYPE"
            description="COM_SPORTSMANAGEMENT_GLOBAL_SPORT_TYPE_DESC"
            required="true">
            <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_SPORTSTYPE</option>
        </field>
        <field
            name="class"
            type="statstypelist"
            default="basic"
            label="COM_SPORTSMANAGEMENT_ADMIN_STAT_TYPE"
            description="COM_SPORTSMANAGEMENT_ADMIN_STAT_TYPE_DESC"
            required="true"/>
        <field
            name="note"
            type="text"
            maxlength="100"
            label="COM_SPORTSMANAGEMENT_ADMIN_STAT_NOTE"
            description="COM_SPORTSMANAGEMENT_ADMIN_STAT_NOTE_DESC"/>
        <field
            name="published"
            type="radio"
            label="JSTATUS"
            description="JFIELD_PUBLISHED_DESC"
            default="1"
            layout="joomla.form.field.radio.switcher">
            <option value="0">JUNPUBLISHED</option>
            <option value="1">JPUBLISHED</option>
        </field>
    </fieldset>

    <fieldset
        name="picture"
        label="COM_SPORTSMANAGEMENT_TABS_PICTURE"
        description="COM_SPORTSMANAGEMENT_TABS_PICTURE_DESC">
        <field
            name="icon"
            type="media"
            default=""
            label="COM_SPORTSMANAGEMENT_GLOBAL_ICON"
            description="COM_SPORTSMANAGEMENT_GLOBAL_ICON_DESC"
            preview="show"
            directory=""/>
    </fieldset>
</form>
