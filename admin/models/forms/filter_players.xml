<?xml version="1.0" encoding="utf-8"?>
<form>
  <fields name="filter" addfieldprefix="Diddipoeler\Component\SportsManagement\Administrator\Field">
    <field name="search" type="text" inputmode="search" label="JSEARCH_FILTER" hint="JSEARCH_FILTER" />
    <field name="state" type="status" label="JOPTION_SELECT_PUBLISHED">
      <option value="">JOPTION_SELECT_PUBLISHED</option>
    </field>
    <field name="sports_type" type="Sportstype" label="COM_SPORTSMANAGEMENT_GLOBAL_SPORT_TYPE">
      <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SPORT_TYPE_SELECT</option>
    </field>
    <field name="search_agegroup" type="Agegroup" label="COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_AGEGROUP">
      <option value="">COM_SPORTSMANAGEMENT_ADMIN_PROJECTS_AGEGROUP_FILTER</option>
    </field>
    <field name="search_nation" type="Country" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_COUNTRY">
      <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_COUNTRY</option>
    </field>
  </fields>
  <fields name="list">
    <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();" />
  </fields>
</form>
