<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter" addfieldprefix="Diddipoeler\Component\SportsManagement\Administrator\Field">
        <field name="search" type="text" inputmode="search" label="JSEARCH_FILTER" hint="JSEARCH_FILTER" />
        <field name="state" type="status" label="JOPTION_SELECT_PUBLISHED">
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>
        <field name="search_division" type="Projectdivision" label="COM_SPORTSMANAGEMENT_ADMIN_DIVISION_S_NAME">
            <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_DIVISION</option>
        </field>
        <field name="search_nation" type="Country" label="COM_SPORTSMANAGEMENT_ADMIN_CLUB_COUNTRY">
            <option value="">COM_SPORTSMANAGEMENT_GLOBAL_SELECT_COUNTRY</option>
        </field>
        <field name="is_in_score" type="list" label="COM_SPORTSMANAGEMENT_ADMIN_P_TEAM_INSCORE">
            <option value="">COM_SPORTSMANAGEMENT_ADMIN_P_TEAM_INSCORE</option>
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="use_finally" type="list" label="COM_SPORTSMANAGEMENT_ADMIN_P_TEAM_USE_FINALLY">
            <option value="">COM_SPORTSMANAGEMENT_ADMIN_P_TEAM_USE_FINALLY</option>
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="playground_id" type="list" label="COM_SPORTSMANAGEMENT_SETTINGS_LABEL_PH_STADIUM">
            <option value="">COM_SPORTSMANAGEMENT_SETTINGS_LABEL_PH_STADIUM</option>
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fields>
    <fields name="list">
        <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();" />
    </fields>
</form>
