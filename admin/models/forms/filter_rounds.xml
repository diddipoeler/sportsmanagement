<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="JGLOBAL_FILTER_FIELD_LABEL"
            description="JGLOBAL_FILTER_FIELD_DESC"
            hint="JSEARCH_FILTER"
        />
        <field
            name="state"
            type="status"
            label="JOPTION_SELECT_PUBLISHED"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>
        <field
            name="tournement"
            type="list"
            default=""
            label="COM_SPORTSMANAGEMENT_ADMIN_ROUNDS_TOURNEMENT"
            description="COM_SPORTSMANAGEMENT_ADMIN_ROUNDS_TOURNEMENT"
            onchange="this.form.submit();"
        >
            <option value="">COM_SPORTSMANAGEMENT_ADMIN_ROUNDS_TOURNEMENT</option>
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fields>

    <fields name="list">
        <field
            name="limit"
            type="limitbox"
            label="COM_SPORTSMANAGEMENT_LIST_LIMIT"
            description="COM_SPORTSMANAGEMENT_LIST_LIMIT_DESC"
            default="25"
            onchange="this.form.submit();"
        />
    </fields>
</form>
