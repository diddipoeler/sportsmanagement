<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
  <name>MOD_SPORTSMANAGEMENT_BIRTHDAY</name>
  <creationDate>August 2026</creationDate>
  <author>JSM-TEAM</author>
  <authorEmail>diddipoeler@arcor.de</authorEmail>
  <authorUrl>https://www.fussballineuropa.de</authorUrl>
  <license>GNU General Public License version 2 or later</license>
  <copyright>Copyright (c) 2014-2026 diddipoeler</copyright>
  <version>3.9.0</version>
  <description>MOD_SPORTSMANAGEMENT_BIRTHDAY_XML_DESC</description>
  <namespace path="src">Diddipoeler\Module\SportsManagementBirthday</namespace>

  <files>
    <folder module="mod_sportsmanagement_birthday">services</folder>
    <folder>src</folder>
    <filename module="mod_sportsmanagement_birthday">mod_sportsmanagement_birthday.php</filename>
    <filename>index.html</filename>
    <filename>helper.php</filename>
    <filename>mod_sportsmanagement_birthday.xml</filename>
    <filename>update-server.xml</filename>
    <folder>tmpl</folder>
  </files>

  <languages>
    <language tag="en-GB">language/en-GB/en-GB.mod_sportsmanagement_birthday.ini</language>
    <language tag="en-GB">language/en-GB/en-GB.mod_sportsmanagement_birthday.sys.ini</language>
    <language tag="de-DE">language/de-DE/de-DE.mod_sportsmanagement_birthday.ini</language>
    <language tag="de-DE">language/de-DE/de-DE.mod_sportsmanagement_birthday.sys.ini</language>
  </languages>

  <config>
    <fields name="params" addfieldprefix="Diddipoeler\Component\SportsManagement\Administrator\Field">
      <fieldset name="basic" description="MOD_SPORTSMANAGEMENT_BASIC_DESC">
        <field type="extensionversion" version="1.1.1" />
        <field type="extensionauthor" />
        <field type="extensiontranslators" translators="COM_SPORTSMANAGEMENT_TRANSLATORS" />
        <field type="extensionlink" linktype="translate" link="https://www.transifex.com/jsm/sportsmanagement/" />
        <field type="extensionlink" linktype="onlinedoc" link="http://jsm-wiki.diddipoeler.de/index.php?title=SM-Module:Birthday" />
        <field type="extensionlink" linktype="forum" link="https://www.fussballineuropa.de/" />
        <field type="extensionlink" linktype="support" link="https://www.fussballineuropa.de/" />
        <field type="extensionlink" linktype="report" link="https://github.com/diddipoeler/sportsmanagement/issues" />
        <field type="extensionlink" linktype="donate" link="https://www.fussballineuropa.de/" />

        <field name="cfg_which_database" type="extensionradiobutton" default="0" class="radio btn-group btn-group-yesno"
          label="COM_SPORTSMANAGEMENT_SETTINGS_USE_JOOMLA_DATABASE_TITLE"
          description="COM_SPORTSMANAGEMENT_SETTINGS_USE_JOOMLA_DATABASE_DESC">
          <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="s" task="seasons" type="dependsql" depends="cfg_which_database" value_field="cfg_which_database" key_field="season_id" size="10" multiple="multiple"
          label="COM_SPORTSMANAGEMENT_GLOBAL_SEASON" description="COM_SPORTSMANAGEMENT_GLOBAL_SEASON_DESC" />
        <field name="p" task="projects" type="dependsql" depends="s" key_field="season_id" value_field="s" size="10" multiple="multiple"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_PROJECTS_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_PROJECTS_DESCR" />
        <field name="use_fav" type="extensionradiobutton" default="1" class="radio btn-group btn-group-yesno"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_USE_FAVORITE_TEAM_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_USE_FAVORITE_TEAM_DESCR">
          <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="teams" type="dependsql" default="0" depends="p" task="projectteamoptions" key_field="project_id" value_field="p" slug="true" size="10"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_TEAM_IDS_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_TEAM_IDS_DESCR" />
        <field name="agegrouplist" type="dependsql" default="0" task="personagegroupoptions"
          label="MOD_SPORTSMANAGEMENT_AGEGROUP_LABEL" description="MOD_SPORTSMANAGEMENT_AGEGROUP_DESC" />
        <field name="limit" type="number" default="1" min="0"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_MAX_BIRTHDAYS_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_MAX_BIRTHDAYS_DESCR" />
        <field name="use_which" type="list" default="0"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_PERSON_TYPES_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_PERSON_TYPES_DESCR">
          <option value="0">MOD_SPORTSMANAGEMENT_BIRTHDAY_PERSON_TYPE_PLAYERS_AND_STAFF</option>
          <option value="1">MOD_SPORTSMANAGEMENT_BIRTHDAY_PERSON_TYPE_ONLY_PLAYERS</option>
          <option value="2">MOD_SPORTSMANAGEMENT_BIRTHDAY_PERSON_TYPE_ONLY_STAFF</option>
        </field>
        <field name="sort_order" type="list" default="-"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_SORT_ORDER_SAME_DAY_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_SORT_ORDER_SAME_DAY_DESCR">
          <option value="-">MOD_SPORTSMANAGEMENT_BIRTHDAY_SAME_DAY_SORTING_OLDEST_FIRST</option>
          <option value="+">MOD_SPORTSMANAGEMENT_BIRTHDAY_SAME_DAY_SORTING_YOUNGEST_FIRST</option>
        </field>
        <field name="maxdays" type="number" default="" min="0"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_MAX_DAYS_AHEAD_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_MAX_DAYS_AHEAD_DESCR" />
        <field name="Itemid" type="number" default="" min="0"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_ITEMID_FOR_LINKS_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_SELECT_ITEMID_FOR_LINKS_DESCR" />

        <field type="extensionsubtitle" title="MOD_SPORTSMANAGEMENT_BIRTHDAY_SPACER_LAYOUT_SETTINGS" color="#2672a6" />
        <field name="name_format" type="nameformat" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_NAME_FORMAT_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_NAME_FORMAT_DESCR" />
        <field name="heading_style" type="text" default="sectiontableheader" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_HEADING_STYLE_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_HEADING_STYLE_DESCR" />

        <field type="extensionsubtitle" title="MOD_SPORTSMANAGEMENT_BIRTHDAY_SPACER_CUSTOMIZE_MESSAGES_DESCR" color="#2672a6" />
        <field name="dayformat" type="text" default="d. F Y" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_DATE_FORMAT_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_DATE_FORMAT_DESCR" />
        <field name="birthdayformat" type="text" default="d.m.Y" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_DATE_OF_BIRTH_FORMAT_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_DATE_OF_BIRTH_FORMAT_DESCR" />
        <field name="futuremessage" type="text" default="in %DAYS_TO% days" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_FUTURE_MESSAGE_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_FUTURE_MESSAGE_DESCR" />
        <field name="todaymessage" type="text" default="TODAY" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_TODAY_MESSAGE_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_TODAY_MESSAGE_DESCR" />
        <field name="tomorrowmessage" type="text" default="tomorrow" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_TOMORROW_MESSAGE_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_TOMORROW_MESSAGE_DESCR" />
        <field name="birthdaytext" type="textarea" default="MOD_SPORTSMANAGEMENT_BIRTHDAY_MESSAGE_FOR_BIRTHDAY_DEFAULT" cols="25" rows="5"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_MESSAGE_FOR_BIRTHDAY_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_MESSAGE_FOR_BIRTHDAY_DESCR" />
        <field name="not_found_text" type="textarea" default="MOD_SPORTSMANAGEMENT_BIRTHDAY_NO_BIRTHDAY_MESSAGE_DEFAULT" cols="25" rows="5"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_NO_BIRTHDAY_MESSAGE_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_NO_BIRTHDAY_MESSAGE_DESCR" />
      </fieldset>

      <fieldset name="views" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_VIEW" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_VIEW_DESC">
        <field name="mode" type="list" default="S" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_LABEL_MODE" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_DESC_MODE">
          <option value="L">LIST</option>
          <option value="B">BOOTSTRAP</option>
          <option value="J">BOOTSTRAP Slider</option>
          <option value="S">Sticker</option>
        </field>
        <field name="show_player_card" type="extensionradiobutton" default="1" class="radio btn-group btn-group-yesno"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_SHOW_PLAYER_CARD_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_SHOW_PLAYER_CARD_DESCR" showon="mode:L">
          <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="show_picture" type="extensionradiobutton" default="0" class="radio btn-group btn-group-yesno"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_SHOW_PLAYER_PICTURE_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_SHOW_PLAYER_PICTURE_DESCR" showon="mode:L[OR]mode:B[OR]mode:J">
          <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="show_player_flag" type="extensionradiobutton" default="1" class="radio btn-group btn-group-yesno"
          label="MOD_SPORTSMANAGEMENT_BIRTHDAY_SHOW_PLAYER_FLAG_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_SHOW_PLAYER_FLAG_DESCR" showon="mode:L[OR]mode:B[OR]mode:J">
          <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="picture_height" type="number" default="50" min="1" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_PICTURE_HEIGHT_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_PICTURE_HEIGHT_DESCR" />
        <field name="picture_width" type="number" default="50" min="1" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_PICTURE_WIDTH_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_PICTURE_WIDTH_DESCR" showon="mode:B[OR]mode:J" />
        <field name="border" type="extensionradiobutton" default="1" class="radio btn-group btn-group-yesno" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_BORDER" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_BORDER_DESC" showon="mode:S">
          <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="border_rounded" type="extensionradiobutton" default="1" class="radio btn-group btn-group-yesno" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_BORDER_ROUNDED" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_BORDER_ROUNDED_DESC" showon="mode:S">
          <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="border_shadow" type="extensionradiobutton" default="1" class="radio btn-group btn-group-yesno" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_BORDER_SHADOW" description="MOD_SPORTSMANAGEMENT_PLAYGROUND_TICKER_BORDER_SHADOW_DESC" showon="mode:S">
          <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="birthday_cake" type="extensionradiobutton" default="1" class="radio btn-group btn-group-yesno" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_CAKE" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_CAKE_DESC" showon="mode:S">
          <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="cake_image" type="accessiblemedia" directory="stories" showon="mode:S" />
        <field name="show_team" type="extensionradiobutton" default="1" class="radio btn-group btn-group-yesno" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_TEAM_NAME" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_TEAM_NAME_DESC" showon="mode:S">
          <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="show_project" type="extensionradiobutton" default="1" class="radio btn-group btn-group-yesno" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_PROJECT_NAME" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_PROJECT_NAME_DESC" showon="mode:S">
          <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="border_color" type="text" default="#41008a" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_BORDER_COLOR" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_BORDER_COLOR_DESC" showon="mode:S" />
        <field name="background_color" type="text" default="#eee" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_BACK_COLOR" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_BACK_COLOR_DESC" showon="mode:S" />
        <field name="title_color" type="text" default="#000000" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_TITLE_COLOR" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_TITLE_COLOR_DESC" showon="mode:S" />
        <field name="title_size" type="number" default="18" min="1" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_TITLE_SIZE" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_TITLE_SIZE_DESC" showon="mode:S" />
        <field name="text_color" type="text" default="#000000" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_TEXT_COLOR" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_TEXT_COLOR_DESC" showon="mode:S[OR]mode:B[OR]mode:J" />
        <field name="text_size" type="number" default="14" min="1" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_TEXT_SIZE" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_TEXT_SIZE_DESC" showon="mode:S[OR]mode:B[OR]mode:J" />
      </fieldset>

      <fieldset name="advanced">
        <field name="table_class" type="list" default="table" label="COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE" description="COM_SPORTSMANAGEMENT_FES_PARAM_DESCR_TABLE_STYLE">
          <option value="table">COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE_TABLE</option>
          <option value="table table-striped">COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE_STRIPED</option>
          <option value="table table-bordered">COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE_BORDERED</option>
          <option value="table table-hover">COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE_HOVER</option>
          <option value="table table-sm">COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE_CONDENSED</option>
        </field>
        <field name="moduleclass_sfx" default="container-fluid" type="text" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />
        <field name="sectiontableentry1" type="text" default="sectiontableentry1" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_PERSON_STYLE_ODD_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_PERSON_STYLE_ODD_DESCR" />
        <field name="sectiontableentry2" type="text" default="sectiontableentry2" label="MOD_SPORTSMANAGEMENT_BIRTHDAY_PERSON_STYLE_EVEN_LABEL" description="MOD_SPORTSMANAGEMENT_BIRTHDAY_PERSON_STYLE_EVEN_DESCR" />
      </fieldset>
    </fields>
  </config>

  <updateservers>
    <server type="extension" priority="1" name="SportsManagement Update Site">https://raw.githubusercontent.com/diddipoeler/sportsmanagement/master/modules/mod_sportsmanagement_birthday/update-server.xml</server>
  </updateservers>
</extension>
