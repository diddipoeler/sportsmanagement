<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_SPORTSMANAGEMENT_FIRSTLEAGUEOVERVIEW</name>
    <author>diddipoeler</author>
    <creationDate>August 2026</creationDate>
    <copyright>(C) 2015-2026</copyright>
    <license>GPL2</license>
    <authorEmail>diddipoeler@gmx.de</authorEmail>
    <authorUrl>https://www.fussballineuropa.de</authorUrl>
    <version>3.9.0</version>
    <description>MOD_SPORTSMANAGEMENT_FIRSTLEAGUEOVERVIEW_DESC</description>
    <namespace path="src">Diddipoeler\Module\SportsManagementFirstLeagueOverview</namespace>

    <files>
        <folder module="mod_sportsmanagement_firstleagueoverview">services</folder>
        <folder>src</folder>
        <filename module="mod_sportsmanagement_firstleagueoverview">mod_sportsmanagement_firstleagueoverview.php</filename>
        <filename>index.html</filename>
        <filename>helper.php</filename>
        <filename>update-server.xml</filename>
        <folder>tmpl</folder>
        <folder>css</folder>
    </files>

    <languages>
        <language tag="de-DE">language/de-DE/de-DE.mod_sportsmanagement_firstleagueoverview.ini</language>
        <language tag="de-DE">language/de-DE/de-DE.mod_sportsmanagement_firstleagueoverview.sys.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.mod_sportsmanagement_firstleagueoverview.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.mod_sportsmanagement_firstleagueoverview.sys.ini</language>
    </languages>

    <config>
        <fields name="params" addfieldprefix="Diddipoeler\Component\SportsManagement\Administrator\Field">
            <fieldset name="basic" description="MOD_SPORTSMANAGEMENT_BASIC_DESC">
                <field type="extensionversion" version="1.1.0" />
                <field type="extensionauthor" />
                <field type="extensiontranslators" translators="COM_SPORTSMANAGEMENT_TRANSLATORS" />
                <field type="extensionlink" linktype="translate" link="https://www.transifex.com/jsm/sportsmanagement/" />
                <field type="extensionlink" linktype="onlinedoc" link="http://jsm-wiki.diddipoeler.de/index.php?title=SM-Module:Firstleagueoverview" />
                <field type="extensionlink" linktype="forum" link="https://www.fussballineuropa.de/" />
                <field type="extensionlink" linktype="support" link="https://www.fussballineuropa.de/" />
                <field type="extensionlink" linktype="report" link="https://github.com/diddipoeler/sportsmanagement/issues" />
                <field type="extensionlink" linktype="donate" link="https://www.fussballineuropa.de/" />

                <field name="cfg_which_database" type="extensionradiobutton" default="0"
                       class="radio btn-group btn-group-yesno"
                       label="COM_SPORTSMANAGEMENT_SETTINGS_USE_JOOMLA_DATABASE_TITLE"
                       description="COM_SPORTSMANAGEMENT_SETTINGS_USE_JOOMLA_DATABASE_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field name="s" task="seasons" type="dependsql"
                       depends="cfg_which_database" value_field="cfg_which_database" key_field="season_id"
                       label="COM_SPORTSMANAGEMENT_XML_SELECT_SEASON_LABEL"
                       description="COM_SPORTSMANAGEMENT_XML_SELECT_SEASON_DESCR" required="" />
            </fieldset>

            <fieldset name="advanced">
                <field name="display_div_table" type="extensionradiobutton" default="1"
                       class="radio btn-group btn-group-yesno"
                       label="MOD_SPORTSMANAGEMENT_FIRSTLEAGUEOVERVIEW_DISPLAY_DIV_TABLE"
                       description="MOD_SPORTSMANAGEMENT_FIRSTLEAGUEOVERVIEW_DISPLAY_DIV_TABLE_DESCR">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field name="table_class" type="list" default="table"
                       label="COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE"
                       description="COM_SPORTSMANAGEMENT_FES_PARAM_DESCR_TABLE_STYLE">
                    <option value="table">COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE_TABLE</option>
                    <option value="table table-striped">COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE_STRIPED</option>
                    <option value="table table-bordered">COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE_BORDERED</option>
                    <option value="table table-hover">COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE_HOVER</option>
                    <option value="table table-sm">COM_SPORTSMANAGEMENT_FES_PARAM_LABEL_TABLE_STYLE_CONDENSED</option>
                </field>

                <field name="moduleclass_sfx" default="container-fluid" type="text"
                       label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                       description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" priority="1" name="SportsManagement Update Site">https://raw.githubusercontent.com/diddipoeler/sportsmanagement/master/modules/mod_sportsmanagement_firstleagueoverview/update-server.xml</server>
    </updateservers>
</extension>
