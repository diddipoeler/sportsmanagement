<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="finder" method="upgrade">
    <name>PLG_FINDER_SPORTSMANAGEMENT</name>
    <creationDate>2026</creationDate>
    <author>JSM Developers</author>
    <authorEmail>diddipoeler@arcor.de</authorEmail>
    <authorUrl>https://www.fussballineuropa.de/</authorUrl>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <copyright>(C) 2014-2026 SportsManagement. All rights reserved.</copyright>
    <version>2.0.0</version>
    <description>PLG_FINDER_SPORTSMANAGEMENT_DESC</description>
    <namespace path="src">Diddipoeler\Plugin\Finder\Sportsmanagement</namespace>
    <scriptfile>script.php</scriptfile>
    <files>
        <folder plugin="jsm_search">services</folder>
        <folder>src</folder>
        <filename>search_sportsmanagement.php</filename>
        <filename>script.php</filename>
        <filename>index.html</filename>
        <filename>update-server.xml</filename>
        <folder>language</folder>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.plg_finder_jsm_search.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.plg_finder_jsm_search.sys.ini</language>
        <language tag="de-DE">language/de-DE/de-DE.plg_finder_jsm_search.ini</language>
        <language tag="de-DE">language/de-DE/de-DE.plg_finder_jsm_search.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="search_clubs" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="PLG_FINDER_SPORTSMANAGEMENT_CLUBS" description="PLG_FINDER_SPORTSMANAGEMENT_CLUBS_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="search_players" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="PLG_FINDER_SPORTSMANAGEMENT_PLAYERS" description="PLG_FINDER_SPORTSMANAGEMENT_PLAYERS_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="search_playgrounds" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="PLG_FINDER_SPORTSMANAGEMENT_PLAYGROUNDS" description="PLG_FINDER_SPORTSMANAGEMENT_PLAYGROUNDS_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="search_referees" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="PLG_FINDER_SPORTSMANAGEMENT_REFEREES" description="PLG_FINDER_SPORTSMANAGEMENT_REFEREES_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="search_staffs" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="PLG_FINDER_SPORTSMANAGEMENT_STAFF" description="PLG_FINDER_SPORTSMANAGEMENT_STAFF_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="search_teams" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="PLG_FINDER_SPORTSMANAGEMENT_TEAMS" description="PLG_FINDER_SPORTSMANAGEMENT_TEAMS_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="search_projects" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="PLG_FINDER_SPORTSMANAGEMENT_PROJECTS" description="PLG_FINDER_SPORTSMANAGEMENT_PROJECTS_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
    <updateservers>
        <server type="extension" priority="1" name="SportsManagement Update Site">https://raw.githubusercontent.com/diddipoeler/sportsmanagement/master/plugins/jsm_search/update-server.xml</server>
    </updateservers>
</extension>
