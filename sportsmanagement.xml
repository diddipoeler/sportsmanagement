<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>COM_SPORTSMANAGEMENT</name>
    <element>com_sportsmanagement</element>
    <creationDate>2013-04-01</creationDate>
    <author>diddipoeler, stony, svdoldie, donclumsy</author>
    <authorEmail>diddipoeler@gmx.de</authorEmail>
    <authorUrl>http://www.fussballineuropa.de</authorUrl>
    <copyright>Copyright Info</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>4.24.02</version>
    <description>COM_SPORTSMANAGEMENT_DESCRIPTION</description>
    <namespace path="src">Diddipoeler\Component\SportsManagement</namespace>

    <scriptfile>script.joomla56.php</scriptfile>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <files folder="site">
        <filename>index.html</filename>
        <filename>sportsmanagement.php</filename>
        <filename>controller.php</filename>
        <filename>router.php</filename>
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>views</folder>
        <folder>helpers</folder>
        <folder>assets</folder>
        <folder>models</folder>
        <folder>settings</folder>
        <folder>extensions</folder>
        <folder>cronjobs</folder>
        <folder>controllers</folder>
        <folder>language</folder>
        <folder>libraries</folder>
        <folder>sisdata</folder>
        <folder>data</folder>
        <folder>lib</folder>
    </files>
    <languages folder="site">
        <language tag="de-DE">language/de-DE/de-DE.com_sportsmanagement.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.com_sportsmanagement.ini</language>
    </languages>

    <media destination="com_sportsmanagement" folder="media/com_sportsmanagement">
        <filename>index.html</filename>
        <folder>agegroups</folder>
        <folder>associations</folder>
        <folder>clubs</folder>
        <folder>events</folder>
        <folder>event_icons</folder>
        <folder>flags</folder>
        <folder>flag_maps</folder>
        <folder>flags_associations</folder>
        <folder>jl_images</folder>
        <folder>leagues</folder>
        <folder>person_playground</folder>
        <folder>persons</folder>
        <folder>placeholders</folder>
        <folder>playgrounds</folder>
        <folder>predictionusers</folder>
        <folder>rosterground</folder>
        <folder>sport_types</folder>
        <folder>teamplayers</folder>
        <folder>treebracket</folder>
        <folder>laender_karten</folder>
        <folder>matchreport</folder>
        <folder>scoresheet</folder>
    </media>

    <administration>
        <menu img="../administrator/components/com_sportsmanagement/assets/icons/transparent_schrift_16.png">COM_SPORTSMANAGEMENT_MENU</menu>
        <submenu>
            <menu view="clubs" img="../administrator/components/com_sportsmanagement/assets/icons/transparent_schrift_16.png" alt="COM_SPORTSMANAGEMENT_D_MENU_CLUBS">COM_SPORTSMANAGEMENT_D_MENU_CLUBS</menu>
            <menu view="teams" img="../administrator/components/com_sportsmanagement/assets/icons/transparent_schrift_16.png" alt="COM_SPORTSMANAGEMENT_D_MENU_CLUBS">COM_SPORTSMANAGEMENT_D_MENU_TEAMS</menu>
            <menu view="players" img="../administrator/components/com_sportsmanagement/assets/icons/transparent_schrift_16.png" alt="COM_SPORTSMANAGEMENT_D_MENU_CLUBS">COM_SPORTSMANAGEMENT_D_MENU_PERSONS</menu>
            <menu view="playgrounds" img="../administrator/components/com_sportsmanagement/assets/icons/transparent_schrift_16.png" alt="COM_SPORTSMANAGEMENT_D_MENU_CLUBS">COM_SPORTSMANAGEMENT_D_MENU_VENUES</menu>
            <menu view="jsmgooglecalendar" img="../administrator/components/com_sportsmanagement/assets/icons/transparent_schrift_16.png" alt="COM_SPORTSMANAGEMENT_D_MENU_CLUBS">COM_SPORTSMANAGEMENT_D_GOOGLE_CALENDAR</menu>
        </submenu>

        <files folder="admin">
            <filename>index.html</filename>
            <filename>config.xml</filename>
            <filename>access.xml</filename>
            <filename>sportsmanagement.php</filename>
            <filename>controller.php</filename>
            <folder>src</folder>
            <folder>services</folder>
            <folder>tmpl</folder>
            <folder>forms</folder>
            <folder>assets</folder>
            <folder>statistics</folder>
            <folder>elements</folder>
            <folder>sql</folder>
            <folder>tables</folder>
            <folder>models</folder>
            <folder>views</folder>
            <folder>controllers</folder>
            <folder>helpers</folder>
            <folder>sisdata</folder>
            <folder>modules</folder>
            <folder>libraries</folder>
            <folder>pkg</folder>
            <folder>layouts</folder>
        </files>
        <languages folder="admin">
            <language tag="de-DE">language/de-DE/de-DE.com_sportsmanagement.ini</language>
            <language tag="de-DE">language/de-DE/de-DE.com_sportsmanagement.sys.ini</language>
            <language tag="en-GB">language/en-GB/en-GB.com_sportsmanagement.ini</language>
            <language tag="en-GB">language/en-GB/en-GB.com_sportsmanagement.sys.ini</language>
        </languages>
    </administration>

    <changelogurl>https://raw.githubusercontent.com/diddipoeler/sportsmanagement/joomla5-6/changelog.xml</changelogurl>
    <updateservers>
        <server type="extension" priority="1" name="SportsManagement Update Site">https://raw.githubusercontent.com/diddipoeler/sportsmanagement/joomla5-6/update-server.xml</server>
    </updateservers>

